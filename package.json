{
  "name": "index",
  "productName": "INDEX",
  "appId": "io.liriliri.index",
  "version": "0.1.0",
  "description": "Ollama desktop app",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "vite build --watch --config vite.main.ts --mode=development",
    "dev:preload": "vite build --watch --config vite.preload.ts --mode=development",
    "dev:renderer": "vite",
    "start": "electron ./dist/main/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "lsla prettier \"indextts/env/*.mjs\" \"src/**/*.{ts,tsx,scss,css,json}\" \"*.{js,ts,json}\" \"script/*.mjs\" --write",
    "genTheme": "lsla genTheme --input src/common/theme.json --output src/renderer/theme.scss && lsla genTheme --input src/common/theme.json --output src/common/theme.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/index.git"
  },
  "keywords": [
    "git"
  ],
  "author": "surunzi",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/liriliri/opheia/issues"
  },
  "homepage": "https://github.com/liriliri/opheia#readme",
  "devDependencies": {
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.11.0",
    "concurrently": "^9.2.0",
    "custom-electron-titlebar": "^4.2.8",
    "electron": "30.5.1",
    "electron-updater": "^6.6.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.0",
    "licia": "^1.48.0",
    "luna-menu": "^0.2.0",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.89.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^5.4.19",
    "zx": "^8.8.0"
  }
}
